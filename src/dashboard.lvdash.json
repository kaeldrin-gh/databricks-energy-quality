{
  "datasets": [
    {
      "name": "ds_checks",
      "displayName": "Latest quality checks",
      "query": "SELECT check_name, status, detail, checked_at\nFROM workspace.energy_quality.quality_report\nWHERE checked_at = (SELECT max(checked_at) FROM workspace.energy_quality.quality_report)\nORDER BY check_name"
    },
    {
      "name": "ds_history",
      "displayName": "Check history",
      "query": "SELECT checked_at, check_name, status\nFROM workspace.energy_quality.quality_report\nORDER BY checked_at DESC\nLIMIT 40"
    },
    {
      "name": "ds_freshness",
      "displayName": "Freshness",
      "query": "SELECT round((unix_timestamp(max(delivery_ts)) - unix_timestamp(current_timestamp())) / 3600, 1) AS hours_ahead\nFROM workspace.energy_quality.silver_prices"
    },
    {
      "name": "ds_summary",
      "displayName": "Summary",
      "query": "SELECT\n  (SELECT count(*) FROM workspace.energy_quality.quality_report\n   WHERE checked_at = (SELECT max(checked_at) FROM workspace.energy_quality.quality_report)\n     AND status = 'ok') AS checks_ok,\n  (SELECT sum(negative_hours) FROM workspace.energy_quality.gold_daily\n   WHERE day >= current_date() - INTERVAL 30 DAYS) AS negative_hours_30d,\n  (SELECT round(avg(avg_price_eur_mwh), 1) FROM workspace.energy_quality.gold_daily\n   WHERE day >= current_date() - INTERVAL 30 DAYS) AS avg_price_30d"
    },
    {
      "name": "ds_daily",
      "displayName": "Daily prices",
      "query": "SELECT day, avg_price_eur_mwh, negative_hours\nFROM workspace.energy_quality.gold_daily\nWHERE day >= current_date() - INTERVAL 30 DAYS\nORDER BY day"
    }
  ],
  "pages": [
    {
      "name": "page_quality",
      "displayName": "Energy quality",
      "layout": [
        {
          "position": {
            "x": 0,
            "y": 0,
            "width": 3,
            "height": 2
          },
          "widget": {
            "name": "widget_checks_ok",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_summary",
                  "disaggregated": false,
                  "fields": [
                    {
                      "expression": "`checks_ok`",
                      "name": "checks_ok"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": {
                "showTitle": true,
                "title": "Checks passed (latest run)"
              },
              "encodings": {
                "value": {
                  "fieldName": "checks_ok",
                  "displayName": "checks_ok"
                }
              }
            }
          }
        },
        {
          "position": {
            "x": 3,
            "y": 0,
            "width": 3,
            "height": 2
          },
          "widget": {
            "name": "widget_freshness",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_freshness",
                  "disaggregated": false,
                  "fields": [
                    {
                      "expression": "`hours_ahead`",
                      "name": "hours_ahead"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": {
                "showTitle": true,
                "title": "Newest delivery hour (hours ahead)"
              },
              "encodings": {
                "value": {
                  "fieldName": "hours_ahead",
                  "displayName": "hours_ahead"
                }
              }
            }
          }
        },
        {
          "position": {
            "x": 6,
            "y": 0,
            "width": 3,
            "height": 2
          },
          "widget": {
            "name": "widget_negative",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_summary",
                  "disaggregated": false,
                  "fields": [
                    {
                      "expression": "`negative_hours_30d`",
