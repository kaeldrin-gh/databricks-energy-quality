{
  "datasets": [
    {
      "name": "ds_checks",
      "displayName": "Latest quality checks",
      "queryLines": [
        "SELECT check_name, status, detail, checked_at\n",
        "FROM workspace.energy_quality.quality_report\n",
        "WHERE checked_at = (SELECT max(checked_at) FROM workspace.energy_quality.quality_report)\n",
        "ORDER BY check_name"
      ]
    },
    {
      "name": "ds_freshness",
      "displayName": "Freshness",
      "queryLines": [
        "SELECT round((unix_timestamp(max(delivery_ts)) - unix_timestamp(current_timestamp())) / 3600, 1) AS hours_ahead\n",
        "FROM workspace.energy_quality.silver_prices"
      ]
    },
    {
      "name": "ds_daily",
      "displayName": "Daily prices",
      "queryLines": [
        "SELECT day, avg_price_eur_mwh, negative_hours\n",
        "FROM workspace.energy_quality.gold_daily\n",
        "WHERE day >= current_date() - INTERVAL 30 DAYS\n",
        "ORDER BY day"
      ]
    }
  ],
  "pages": [
    {
      "name": "page_quality",
      "displayName": "Energy quality",
      "layout": [
        {
          "widget": {
            "name": "widget_checks",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_checks",
                  "fields": [
                    {
                      "name": "check_name",
                      "expression": "`check_name`"
                    },
                    {
                      "name": "status",
                      "expression": "`status`"
                    },
                    {
                      "name": "detail",
                      "expression": "`detail`"
                    },
                    {
                      "name": "checked_at",
                      "expression": "`checked_at`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "frame": {
                "showTitle": true,
                "title": "Latest quality checks"
              },
              "encodings": {
                "columns": [
                  {
                    "fieldName": "check_name",
                    "displayName": "check_name",
                    "type": "string",
                    "displayAs": "string",
                    "visible": true
                  },
                  {
                    "fieldName": "status",
                    "displayName": "status",
                    "type": "string",
                    "displayAs": "string",
                    "visible": true
                  },
                  {
                    "fieldName": "detail",
                    "displayName": "detail",
                    "type": "string",
                    "displayAs": "string",
                    "visible": true
                  },
                  {
                    "fieldName": "checked_at",
                    "displayName": "checked_at",
                    "type": "datetime",
                    "displayAs": "datetime",
                    "visible": true
                  }
                ]
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "widget_freshness",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_freshness",
                  "fields": [
                    {
                      "name": "hours_ahead",
                      "expression": "`hours_ahead`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": {
                "showTitle": true,
                "title": "Newest delivery hour (hours ahead)"
              },
              "encodings": {
                "value": {
                  "fieldName": "hours_ahead",
                  "displayName": "hours_ahead"
                }
              }
            }
          },
          "position": {
            "x": 6,
            "y": 0,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "widget_daily",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily",
                  "fields": [
                    {
                      "name": "avg_price_eur_mwh",
                      "expression": "`avg_price_eur_mwh`"
                    },
                    {
                      "name": "day",
                      "expression": "`day`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "frame": {
                "showTitle": true,
                "title": "Average day-ahead price (last 30 days)"
              },
              "mark": {
                "colors": [
                  "#077A9D"
                ]
              },
              "encodings": {
                "x": {
                  "fieldName": "day",
                  "displayName": "day",
                  "scale": {
                    "type": "temporal"
                  },
                  "axis": {
                    "title": "Day"
                  }
                },
                "y": {
                  "fieldName": "avg_price_eur_mwh",
                  "displayName": "avg_price_eur_mwh",
                  "scale": {
                    "type": "quantitative"
                  },
                  "axis": {
                    "title": "EUR/MWh"
                  }
                }
              }
            }
          },
          "position": {
            "x": 6,
            "y": 2,
            "width": 6,
            "height": 4
          }
        }
      ],
      "pageType": "PAGE_TYPE_CANVAS"
    }
  ]
}
